{
  "name": "redroomrewards",
  "version": "0.1.0",
  "description": "A Ledger-Based Loyalty and Rewards Platform",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:verbose": "jest --verbose",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "lint": "eslint . --max-warnings=0",
    "lint:ci-python": "node -e \"console.log('No Python lint gate configured in this npm-only repository.')\"",
    "lint:ci-js": "eslint . --max-warnings=0 && prettier --check . && tsc --noEmit",
    "lint:ci": "npm run lint:ci-python && npm run lint:ci-js",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:schema": "node scripts/validate-schema.js",
    "seed:alpha-staging": "ts-node scripts/seed-alpha-staging.ts",
    "teardown:alpha-staging": "ts-node scripts/teardown-alpha-staging.ts",
    "reconcile": "ts-node scripts/reconcile.ts",
    "type-check": "tsc --noEmit",
    "ship-gate": "npx tsx PROGRAM_CONTROL/ship-gate-verifier.ts",
    "prepare": "husky"
  },
  "keywords": [
    "loyalty",
    "rewards",
    "ledger",
    "wallet",
    "nextjs",
    "typescript"
  ],
  "author": "OmniQuestMedia",
  "license": "UNLICENSED",
  "dependencies": {
    "@nestjs/config": "^4.0.4",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/swagger": "^11.4.4",
    "@types/jsonwebtoken": "^9.0.10",
    "express-rate-limit": "^8.5.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.3",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.24",
    "@nestjs/core": "^11.1.27",
    "@nestjs/testing": "^11.1.24",
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.24",
    "@nestjs/testing": "^11.1.27",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.60.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.6.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
