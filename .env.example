# RedRoomRewards Environment Configuration
# Copy this file to .env and fill in the values
# NEVER commit .env files with real secrets to git

# ============================================
# Application Environment
# ============================================
NODE_ENV=development  # development | test | production

# ============================================
# Database Configuration
# ============================================
# MongoDB connection string
# Format: mongodb://username:password@host:port/database
# Production / staging: Use MongoDB Atlas (or self-hosted) and **must** be a
# REPLICA SET — multi-document transactions (mongoose.startSession, used by
# the wallet/escrow flows in B-006) require a replica set. A single-node
# Mongo will fail at runtime.
# Recommended Atlas tier: M10+ in TOR1 (Toronto) for Canadian data residency.
# Recommended URI shape: mongodb+srv://USER:PASS@CLUSTER/redroomrewards?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/redroomrewards?replicaSet=rs0

# Payload #11 deployment contract alias. Populate with the same
# value as MONGODB_URI for clients that expect DATABASE_URL.
DATABASE_URL=mongodb+srv://user:password@cluster/redroomrewards?retryWrites=true&w=majority

# ============================================
# Security & Authentication
# ============================================
# JWT signing secret (REQUIRED, minimum 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secure-jwt-secret-minimum-32-characters-required-here

# Queue authorization token secret (REQUIRED, minimum 32 characters)
# Used for authorizing settlement/refund operations
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QUEUE_AUTH_SECRET=your-secure-queue-auth-secret-minimum-32-characters

# Token expiry in seconds (default: 900 = 15 minutes)
TOKEN_EXPIRY_SECONDS=900

# ============================================
# Webhook Configuration
# ============================================
# RRR webhook signature verification secret (REQUIRED, minimum 32 characters)
# Used to verify incoming webhooks from external systems
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RRR_WEBHOOK_SECRET=your-secure-webhook-secret-minimum-32-characters-required

# WooCommerce webhook signature secret (RedRoomPleasures integration)
# Set in WooCommerce > Settings > Advanced > Webhooks — must match this value
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WOOCOMMERCE_WEBHOOK_SECRET=your-woocommerce-webhook-secret-minimum-32-characters

# Tenant/merchant this WooCommerce store maps to (RRR is the arm's-length
# provider; the store→tenant binding is deployment config, not code).
# WOOCOMMERCE_MERCHANT_ID defaults to WOOCOMMERCE_TENANT_ID when unset.
# The earn rate is NOT set here — it comes from the tenant's active
# EarnRateConfig (event_class=PURCHASE). Seed that config before enabling
# the integration or orders fail closed (no points issued).
WOOCOMMERCE_TENANT_ID=redroompleasures
WOOCOMMERCE_MERCHANT_ID=redroompleasures

# ============================================
# Service Configuration
# ============================================
# Service port (default: 3000)
PORT=3000

# API base path
API_BASE_PATH=/api/v1

# ============================================
# Logging & Monitoring
# ============================================
# Log level: debug | info | warn | error
LOG_LEVEL=info

# Enable structured JSON logging
LOG_FORMAT=json

# ============================================
# Feature Flags (Development/Testing)
# ============================================
# Enable debug mode (NEVER in production)
DEBUG_MODE=false

# Enable verbose logging (NEVER in production)
VERBOSE_LOGGING=false

# ============================================
# Rate Limiting
# ============================================
# Requests per minute per IP (general)
RATE_LIMIT_PER_MINUTE=100

# Requests per minute per IP for the unauthenticated signup endpoint.
# Tighter than the general limit because account-creation is the #1 bot-flood
# and credential-stuffing vector. Default 5/min if unset.
SIGNUP_RATE_LIMIT_PER_MINUTE=5

# ============================================
# CORS Configuration
# ============================================
# Allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================
# GateGuard Sentinel™ — 18+ Age Verification
# ============================================
# Mandatory for every account action (signup, high-value awards, burns).
# Obtain a key from the GateGuard admin console.
GATEGUARD_AV_API_KEY=your-gateguard-key-here
GATEGUARD_AV_ENDPOINT=https://api.gateguard.omniquestmedia.com

# ============================================
# White-Label Service Bureau
# ============================================
# When true, the engine runs in hosted service-bureau mode (multi-tenant).
# When false, the engine runs as a self-hosted single-tenant deployment.
SERVICE_BUREAU_ENABLED=true

# ============================================
# OKIB — OmniQuest Knowledge & Intelligence Bus (advisory personalization)
# ============================================
# Gated, advisory integration. When false (default), all OKIB calls return a
# neutral result and never run. OKIB is NEVER in the path of the ledger,
# wallet, earn, or redeem. See docs/okib-integration-plan.md.
# When OKIB_ENABLED=true, OKIB_BASE_URL (HTTPS) and OKIB_API_KEY are required;
# if missing the service fails open (behaves as disabled).
OKIB_ENABLED=false
OKIB_BASE_URL=https://okib-staging.omniquestmedia.com
OKIB_API_KEY=your-okib-key-here

# ============================================
# Notes
# ============================================
# 1. All secrets MUST be at least 32 characters long
# 2. Use cryptographically secure random generation for secrets
# 3. Never use default values like 'changeme', 'secret', 'password'
# 4. Rotate secrets quarterly or immediately on compromise
# 5. Store production secrets in secure vault (AWS Secrets Manager, etc.)
# 6. Never commit .env files to git
# 7. See SECURITY_BEST_PRACTICES.md for more information

# ============================================
# Security Checklist
# ============================================
# [ ] All secrets are at least 32 characters
# [ ] Secrets are cryptographically random
# [ ] No default or insecure values used
# [ ] .env file is in .gitignore
# [ ] Production secrets stored in secure vault
# [ ] All required variables are set
