# RedRoomRewards Member Portal — Environment Variables

# RRR API base URL (backend service)
NEXT_PUBLIC_RRR_API_URL=http://localhost:3000/api/v1

# AccountsZone login URL — members are redirected here when no JWT is present
NEXT_PUBLIC_ACCOUNTS_ZONE_URL=https://accounts.omniquestmedia.com

# Tenant identifier for this portal deployment
NEXT_PUBLIC_TENANT_ID=redroompleasures
